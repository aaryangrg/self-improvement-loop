{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis", "changes_made", "expected_outcome"],
  "properties": {
    "hypothesis": {"type": "string"},
    "changes_made": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Concise descriptions of what changed and why it was selected; no file paths."
    },
    "expected_outcome": {"type": "string"}
  }
}
